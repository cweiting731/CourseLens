# =========================
# Python
# =========================
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# =========================
# SQLite / Local data
# =========================
backend/*.db
backend/*.sqlite
backend/*.sqlite3

# If you want to ignore all db files anywhere, uncomment:
# *.db
# *.sqlite
# *.sqlite3

# =========================
# Environment / secrets
# =========================
.env
.env.*
*.key
*.pem

# =========================
# OS / Editor
# =========================
.DS_Store
Thumbs.db
.vscode/
.idea/

# =========================
# Frontend (only if you use Node tooling)
# =========================
node_modules/
dist/
build/

# =========================
# Logs / temp
# =========================
*.log
*.tmp
*.bak
*.swp

# =========================
# Optional: large documents (UNCOMMENT if you don't want them in git)
# =========================
# *.pdf
# *.docx
# *.pptx
# *.zip
